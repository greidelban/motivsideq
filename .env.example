# Copia questo file in .env.local e compila i valori (vedi README, "Configurare Supabase").
# .env.local non va mai condiviso né caricato su git.
# Senza questi valori l'app funziona lo stesso, solo sul dispositivo (l'account non compare).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Chiave "publishable" (sb_publishable_...): è pensata per il browser, i permessi li decide la Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Indirizzo dell'app: usato nei link delle email (conferma account, recupero password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chiave "secret" (sb_secret_...): SCAVALCA la sicurezza del database. Oggi l'app non la usa;
# servirà solo lato server (es. cancellazione account). MAI con prefisso NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
