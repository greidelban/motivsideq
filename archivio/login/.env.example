# Copia questo file in .env.local e compila i valori (vedi README, "Configurare Supabase").
# .env.local non va mai condiviso né caricato su git.

# Supabase → Project Settings → API (o Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Chiave pubblica "anon" (o la nuova "publishable" sb_publishable_...): è pensata per il browser,
# i permessi li decide la Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave "service_role" (o la nuova "secret" sb_secret_...): SCAVALCA la sicurezza del database.
# Solo lato server (cancellazione account). MAI con prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Indirizzo dell'app: usato nei link delle email (conferma account, recupero password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
